#!/bin/sh
APP_DIR="$(dirname "$(readlink -f "$0")")"
export APP_DIR

# Start background reminder daemon in user session if not already running
if ! pgrep -f "personalfitnessapp-reminder-daemon.py" > /dev/null 2>&1; then
    if command -v systemd-run > /dev/null 2>&1; then
        systemd-run --user --unit=personalfitnessapp-reminder-daemon python3 "$APP_DIR/personalfitnessapp-reminder-daemon.py" > /dev/null 2>&1 || python3 "$APP_DIR/personalfitnessapp-reminder-daemon.py" > /dev/null 2>&1 &
    else
        python3 "$APP_DIR/personalfitnessapp-reminder-daemon.py" > /dev/null 2>&1 &
    fi
fi

exec qmlscene "$@" "$APP_DIR/qml/Main.qml"
